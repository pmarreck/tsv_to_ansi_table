# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
depth=3

annotate=[
	.build-work = Generated build scratch directories and executable-publication lock
	.dirtree-state = Saved tree depth, visibility settings, and file-purpose notes
	.gitignore = Exclude local instructions, inbox messages, and generated build artifacts
	.mechatron-prime = Exact-commit continuous-integration target configuration
	.mechatron-prime/targets = Exact-commit native tests and cross-compilation CI targets
	.nix-out = Nix output links retaining immutable builds by target and profile
	INTENT.md = Accepted table-rendering behavior and verification criteria
	LICENSE = MIT license terms for the project
	PLAN.md = Open tasks and recent completed milestones
	README.md = Usage examples, build instructions, flags, and supported targets
	bin = Platform-specific links to validated built executables
	bm = Compare optimized Roc and Zig with verified identical workloads
	build = Build optimized or debug Nix packages and publish host executable links
	build.zig = Build the Zig executable and safety-enabled core tests with utf8proc
	build.zig.zon = Zig package identity and pinned random library dependency
	docs = CLI contract, benchmark observations, and completed work history
	docs/PLAN_LOG.md = Append-only record of completed implementation milestones
	docs/benchmark-results.md = Initial verified whole-process Roc and Zig timing comparison
	docs/cli-contract.md = Detailed parsing, layout, Unicode, streaming, and glyph behavior
	flake.lock = Exact revisions and content hashes for Nix flake inputs
	flake.nix = Pinned toolchains, development shell, native checks, and cross-target packages
	main.zig = Root Zig CLI entry point and pure-core test discovery
	platform = Native terminal and locale bridge shared by the CLI implementations
	platform/Console.roc = Roc declarations for native terminal-width and Windows locale queries
	platform/console.c = Native console width and Windows decimal separator queries
	profiling.json = Shared benchmark cases and historical cohort identity
	run = Build and run the Roc CLI for the current host
	scripts = Build helpers for host selection, pinned dependencies, and executable links
	scripts/build-native = Compile and install both implementations for the current host
	scripts/host = Detect supported host OS and architecture and derive target names
	scripts/publish = Validate host binaries and atomically update platform-specific executable links
	scripts/roc-env = Run Roc with dependencies resolved to Nix-provided local sources
	scripts/zig-env = Populate the Zig package cache from pinned Nix sources before invoking Zig
	src = Roc functional core and CLI adapter
	src/BuildInfo.roc = Release banner value replaced with a warning in debug builds
	src/Engine.roc = Pure incremental table state and bounded streaming output
	src/Example.roc = Pure seeded example rows using the random Roc library
	src/Glyphs.roc = Pure named glyph profile parsing and display-cell validation
	src/Options.roc = Validated CLI configuration and positional column options
	src/Render.roc = Pure table layout and row/border rendering
	src/Table.roc = Pure TSV parsing, numeric inference, header selection, and width allocation
	src/Text.roc = Unicode-safe measurement, sanitization, clipping, and alignment
	src/example-words.txt = Shared 100-entry corporate and LLM-themed example vocabulary
	src/help.txt = Shared CLI help text checked against both implementations
	src/main.roc = Roc argument, environment, locale, stdin, and stdout adapter
	test = Complete deterministic unit and real CLI acceptance entry point
	tests = Shared CLI acceptance suites and benchmark validation
	tests/benchmark = Benchmark measurement adapter and independent output validation
	tests/benchmark/adapter = Smoke-test measurements and reject executables that skip the workload
	tests/benchmark/measure.lua = Measure subprocess wall and CPU time and verify every output sample
	tests/benchmark/oracle.lua = Generate deterministic TSV workloads and verify row content and order
	tests/benchmark/test-oracle.lua = Check rejection of missing, reordered, rounded, and extra benchmark output
	tests/capture.bash = Capture command stdout, stderr, and exit status in Bash without temp files
	tests/cli = Black-box stdin and output checks shared by both executables
	tests/cli/check = Exact-output header and alignment fixtures plus help and about checks
	tests/cli/debug = Assert the yellow debug-build announcement on stderr
	tests/cli/errors = Reject invalid options, malformed rows, narrow layouts, and invalid UTF-8
	tests/cli/example = Seed replay, validation, generated data shape, headers, and stdin independence
	tests/cli/glyphs = Shared environment glyph overrides and rejection classifier tests
	tests/cli/parity = Compare Roc and Zig output across width, alignment, overflow, and style combinations
	tests/cli/semantics = Check headers, numeric precision, CRLF, empty fields, colors, and control sanitization
	tests/cli/streaming = Verify fixed-width output before EOF using a controlled producer handshake
	zig = Zig implementation of the shared CLI contract
	zig-pkg = Generated Zig dependency cache populated from pinned Nix sources
	zig/core.zig = Pure TSV parsing, numeric classification, width allocation, and core tests
	zig/example.zig = Pure seeded example rows using the random Zig library
	zig/glyphs.zig = Zig glyph configuration and safe grapheme validation
	zig/main.zig = Zig stdin/stdout, locale and terminal adapters
	zig/options.zig = Parse and validate Zig CLI flags and per-column settings
	zig/render.zig = Pure Zig layout preparation and row and border rendering
	zig/text.zig = Unicode grapheme measurement, sanitization, clipping, and alignment via utf8proc
]
