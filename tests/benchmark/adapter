#!/usr/bin/env bash
set -u
products=${1:?optimized product bin directory required}
source tests/capture.bash
out= err= rc=
capture env TSV_BENCH_BIN="$products" luajit tests/benchmark/measure.lua zig-auto-1 3 15
if [[ $rc != 0 || -n $err ]] || ! printf '%s' "$out" | jq -e '.correct == true and (.rows[0].samples.wall_ns | length) == 5' >/dev/null; then
	printf 'FAIL benchmark real adapter: %s\n' "$err"; exit 1
fi
# The adapter must reject a command that exits successfully but skips the work.
work=$(mktemp -d "${TMPDIR:-/tmp}/tsv-benchmark-negative.XXXXXXXX") || exit 1
printf '#!%s\nexit 0\n' "$BASH" > "$work/tsv-to-ansi-table-zig"
chmod +x "$work/tsv-to-ansi-table-zig"
capture env TSV_BENCH_BIN="$work" luajit tests/benchmark/measure.lua zig-auto-1 3 15
if [[ $rc == 0 || $err != *'incorrect, missing, or reordered output'* ]]; then printf 'FAIL benchmark skipped-work rejection\n'; exit 1; fi
printf 'PASS benchmark adapter and skipped-work rejection\n'
