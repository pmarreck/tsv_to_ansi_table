#!/usr/bin/env bash
set -u
cli=${1:?pass exact executable}
source "$(dirname "$0")/../capture.bash"
failures=0
error_case() {
	local label=$1 input=$2
	shift 2
	local out err rc
	capture "$cli" "$@" <<< "$input"
	if [[ $rc == 0 || -z $err || $err != tsv-to-ansi-table:* ]]; then
		printf 'FAIL %s (exit %s; stderr %q)\n' "$label" "$rc" "$err"
		failures=$((failures + 1))
	fi
}
error_case ragged $'a\tb\n1' --color never
error_case extra-empty-cell $'a\tb\n1\t2\t' --color never
error_case narrow $'a\tb\n1\t2' --terminal-width 8
error_case fixed-too-wide $'a\tb\n1\t2' --widths 8,8 --terminal-width 12
error_case header-count $'a\tb\n1\t2' --headers One
error_case option-count $'a\n1' --widths 3,3
error_case invalid-utf8 $'a\n\xff' --color never
error_case invalid-header-utf8 '' --header $'\xff' --help
error_case unknown-flag '' --wat
error_case missing-value '' --widths
error_case zero-width '' --widths 0
error_case oversized-width '' --terminal-width 10001
error_case invalid-align '' --align sideways
error_case invalid-color '' --color sometimes
error_case invalid-overflow '' --overflow wrap
error_case invalid-decimal '' --decimal-separator x
if [[ $failures == 0 ]]; then printf 'PASS CLI errors\n'; fi
exit "$failures"
