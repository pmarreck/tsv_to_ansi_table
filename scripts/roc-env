#!/usr/bin/env bash
set -u
exec roc "$@" \
	--replace-dep https://github.com/pmarreck/random/archive/76ada4a2d6259569f901985b08d8d5ad10f45059.tar.gz "$RANDOM_SRC/roc/main.roc" \
	--replace-dep https://github.com/roc-lang/basic-cli/releases/download/0.25.0/CZsY7tYZwR3rj9kYbpaCfxki2yVAaRL8bBwMLvB2xkbA.tar.zst "$ROC_PLATFORM/main.roc" \
	--replace-dep https://github.com/roc-lang/http/releases/download/1.0.0/6ZUwqYhCS8PU9Mo6MF7oV82ET2o7KYb57CLKDq4cq4sS.tar.zst "$ROC_HTTP/main.roc" \
	--replace-dep https://github.com/roc-lang/unicode/releases/download/4.2.0/4W8SHzvwet9hH9qZewJ1J1CVQoH7YKA6zyijWFTB3y1w.tar.zst "$ROC_UNICODE/main.roc"
